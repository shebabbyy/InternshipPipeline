# Copy this file to ".env" (same folder) and fill in your keys. Never share or upload .env.
# Free key: https://aistudio.google.com/apikey  (use your shehabby05 Google account)
GOOGLE_API_KEY=
# Optional, free plan (~25 searches/month): https://hunter.io/api-keys
HUNTER_API_KEY=
# Optional backup (Apollo's people search is paid-only, so this may be refused): https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=
# Path to the Google service-account file (see SETUP step 6). Leave as-is if you saved it in this folder.
GOOGLE_SERVICE_ACCOUNT_JSON=google_service_account.json
# Do NOT set ANTHROPIC_API_KEY. Claude Code must use your Pro login, not paid API billing.
