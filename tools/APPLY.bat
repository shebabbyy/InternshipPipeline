@echo off
REM Opens and fills ready applications in Chrome, records what you submitted, then makes outreach drafts.
chcp 65001 >nul
set PYTHONUTF8=1
cd /d "%~dp0.."
if not exist .venv\Scripts\python.exe (
  echo The pipeline is not installed yet. Double-click INSTALL.bat first.
  pause
  exit /b 1
)
.venv\Scripts\python.exe pipeline\run_all.py --apply
pause
